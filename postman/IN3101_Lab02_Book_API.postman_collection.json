  "item": [
    {
      "name": "S1 - POST Create Book (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.id) {",
              "    pm.collectionVariables.set(\"disposableBookId\", String(jsonData.id));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Java Concurrency in Practice\",\n  \"author\": \"Brian Goetz\",\n  \"isbn\": \"9780321349606\",\n  \"price\": 4200.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ]
        }
      }
    },
    {
      "name": "S2 - GET List All Books (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Contains at least 3 books and student index book\", function () {",
              "    var books = pm.response.json();",
              "    pm.expect(books.length).to.be.at.least(3);",
              "    pm.expect(books.some(b => b.title && b.title.includes(\"235115D\"))).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": [
